{
    "lab_number": 3,
    "variant": "07",
    "dataset_path": "data/raw/train.csv",
    "target_column": "Survived",

    "random_state": 42,
    "test_size": 0.2,
    "validation_size": 0.2,

    "numeric_features": [
        "Age",
        "Fare",
        "SibSp",
        "Parch"
    ],
    "categorical_features": [
        "Pclass",
        "Sex",
        "Embarked"
    ],

    "data": {
        "chunk_size": 64,
        "loading_modes": [
            "full",
            "streaming"
        ]
    },

    "model": {
        "architecture": "MLP",
        "hidden_dims": [
            32,
            16
        ],
        "dropout": 0.1
    },

    "training": {
        "batch_size": 32,
        "epochs": 100,
        "learning_rate": 0.001,
        "weight_decay": 0.0001,
        "early_stopping_patience": 12,
        "early_stopping_min_delta": 0.0001
    },

    "evaluation": {
        "bootstrap_iterations": 1000,
        "confidence_level": 0.95,
        "precision_at_fraction": 0.2
    },

    "reproducibility": {
        "deterministic": true,
        "same_seed_tolerance": 0.005,
        "device_parity_tolerance": 0.00001
    },

    "runtime": {
        "device": "auto",
        "num_workers": 0
    },

    "mlflow": {
        "experiment_name": "Titanic_Lab3",
        "tracking_uri": "sqlite:///mlflow.db"
    },

    "output_dir": "reports/LAB3"
}
